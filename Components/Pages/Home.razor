@page "/"
@rendermode InteractiveServer
@inject HttpClient Http
@inject VacancyService VacancyService
@inject ProtectedLocalStorage BrowserStorage
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using BlazorApp1.Services
@using System.Linq

<PageTitle>Парсер Вакансий</PageTitle>

<h1 class="mb-4">Сбор вакансий</h1>

<!-- Блок настроек с вводом ключа -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">Настройки ИИ</h5>
        <div class="input-group mb-3">
            <span class="input-group-text">🔑 API Key</span>
            <input type="password" class="form-control" @bind="apiKey" @bind:event="oninput" placeholder="Ключ Groq (gsk_...)" />
        </div>
        
        <!-- НОВЫЕ ФИЛЬТРЫ -->
        <div class="row">
            <!-- 1. Ключевое слово для поиска на Djinni -->
            <div class="col-md-4 mb-2">
                <div class="input-group">
                    <span class="input-group-text">🔍 Поиск (Стек)</span>
                    <input type="text" class="form-control" @bind="searchKeyword" placeholder="C#, Java, Python, QA..." />
                </div>
            </div>
            
            <!-- 2. Желаемая должность -->
            <div class="col-md-4 mb-2">
                <div class="input-group">
                    <span class="input-group-text">💼 Должность</span>
                    <select class="form-select" @bind="targetRole">
                        <option value="Trainee/Junior Software Engineer (.NET)">Trainee/Junior .NET</option>
                        <option value="Middle Software Engineer (.NET)">Middle .NET</option>
                        <option value="Fullstack Developer (.NET + React/Angular)">Fullstack .NET</option>
                        <option value="Любой Backend разработчик">Любой Backend</option>
                    </select>
                </div>
            </div>

            <!-- 3. Опыт -->
            <div class="col-md-4 mb-2">
                <div class="input-group">
                    <span class="input-group-text">⏳ Опыт</span>
                    <select class="form-select" @bind="targetExp">
                        <option value="Без коммерческого опыта (Студент)">Без коммерческого опыта</option>
                        <option value="Менее 1 года">Менее 1 года</option>
                        <option value="1-3 года">1-3 года</option>
                        <option value="Более 3 лет">Более 3 лет</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Панель управления -->
<div class="d-flex justify-content-between mb-3 align-items-center">
    <div>
        <button class="btn btn-primary" @onclick="StartParsing" disabled="@IsButtonDisabled">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span> Парсинг и анализ...</span>
            }
            else
            {
                <span>🌐 Свежий парсинг (Djinni)</span>
            }
        </button>
        <button class="btn btn-outline-secondary ms-2" @onclick="LoadFromDb">
            🗄 Обновить из БД
        </button>
        <button class="btn btn-outline-danger ms-2" @onclick="ClearCache">
            🗑 Очистить кэш
        </button>
    </div>
    
    <div class="btn-group" role="group">
        <button type="button" class="btn @(showOnlySaved ? "btn-outline-primary" : "btn-primary")" @onclick="() => SetView(false)">Все (Кэш)</button>
        <button type="button" class="btn @(showOnlySaved ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(true)">⭐ Избранное</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-2">@errorMessage</div>
}

<!-- Таблица с результатами -->
@if (displayVacancies != null && displayVacancies.Any())
{
    <table class="table table-hover table-bordered shadow-sm align-middle">
        <thead class="table-dark">
        <tr>
            <th style="width: 50px;" class="text-center">#</th>
            <th style="cursor: pointer;" @onclick='() => SortBy("Title")'>
                Название @GetSortIcon("Title")
            </th>
            <th style="cursor: pointer;" @onclick='() => SortBy("RequiredExperience")'>
                Опыт @GetSortIcon("RequiredExperience")
            </th>
            <th>Стек (ИИ)</th>
            <th>Саммари (ИИ)</th>
            <th style="cursor: pointer; width: 100px;" class="text-center" @onclick='() => SortBy("AiMatchScore")'>
                Скор @GetSortIcon("AiMatchScore")
            </th>
        </tr>
        </thead>
        <tbody>
            @foreach (var vac in displayVacancies)
            {
                <tr>
                    <td class="text-center text-nowrap">
                        <button class="btn btn-sm @(vac.IsSaved ? "btn-warning" : "btn-light")" @onclick="() => ToggleSave(vac)" style="width: 35px;" title="В избранное">
                            @(vac.IsSaved ? "⭐" : "☆")
                        </button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => RejectVacancy(vac)" style="width: 35px;" title="Скрыть навсегда">
                            🗑
                        </button>
                    </td>
                    <td><a href="@vac.Url" target="_blank" class="text-decoration-none fw-bold">@vac.Title</a></td>
                    <td>@vac.RequiredExperience</td>
                    <td>@vac.TechStack</td>
                    <td>@vac.AiSummary</td>
                    <td class="text-center">
                        <span class="badge rounded-pill @(vac.AiMatchScore > 70 ? "bg-success" : (vac.AiMatchScore > 40 ? "bg-warning text-dark" : "bg-danger"))" style="font-size: 1rem;">
                            @vac.AiMatchScore
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (hasLoaded)
{
    <div class="alert alert-info">В базе данных пока пусто. Запустите свежий парсинг.</div>
}

@code {
    private string searchKeyword = ""; // Значение по умолчанию
    private string apiKey = "";
    private string targetRole = "";
    private string targetExp = "";
    private bool isLoading = false;
    private bool hasLoaded = false;
    private string errorMessage = "";
    private bool showOnlySaved = false;
    
    private List<BlazorApp1.Models.Vacancy> displayVacancies = new();

    private bool IsButtonDisabled => isLoading || string.IsNullOrWhiteSpace(apiKey) || apiKey.Length < 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadFromDb();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Читаем из памяти только один раз при первой загрузке страницы
        if (firstRender)
        {
            var keywordResult = await BrowserStorage.GetAsync<string>("savedKeyword");
            if (keywordResult.Success && !string.IsNullOrEmpty(keywordResult.Value)) 
                searchKeyword = keywordResult.Value;
            
            var keyResult = await BrowserStorage.GetAsync<string>("savedApiKey");
            if (keyResult.Success && !string.IsNullOrEmpty(keyResult.Value)) 
                apiKey = keyResult.Value;

            var roleResult = await BrowserStorage.GetAsync<string>("savedRole");
            if (roleResult.Success && !string.IsNullOrEmpty(roleResult.Value)) 
                targetRole = roleResult.Value;

            var expResult = await BrowserStorage.GetAsync<string>("savedExp");
            if (expResult.Success && !string.IsNullOrEmpty(expResult.Value)) 
                targetExp = expResult.Value;

            // Говорим Блазору: "Мы обновили переменные, перерисуй интерфейс"
            StateHasChanged();
        }
    }
    
    private string currentSortColumn = "AiMatchScore";
    private bool isAscending = false; 

    private void SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            isAscending = !isAscending;
        }
        else
        {
            currentSortColumn = columnName;
            isAscending = true;
        }

        ApplySorting();
    }

    private void ApplySorting()
    {
        displayVacancies = currentSortColumn switch
        {
            "Title" => isAscending 
                ? displayVacancies.OrderBy(v => v.Title).ToList() 
                : displayVacancies.OrderByDescending(v => v.Title).ToList(),
            "RequiredExperience" => isAscending 
                ? displayVacancies.OrderBy(v => ParseExperienceToMonths(v.RequiredExperience)).ToList() 
                : displayVacancies.OrderByDescending(v => ParseExperienceToMonths(v.RequiredExperience)).ToList(),
            "AiMatchScore" => isAscending 
                ? displayVacancies.OrderBy(v => v.AiMatchScore).ToList() 
                : displayVacancies.OrderByDescending(v => v.AiMatchScore).ToList(),
            _ => displayVacancies
        };
    }

    private string GetSortIcon(string columnName)
    {
        if (currentSortColumn != columnName) return "↕";
        return isAscending ? "▲" : "▼";
    }

    private async Task ClearCache()
    {
        try
        {
            await VacancyService.ClearCacheAsync();
            await LoadFromDb();
        }
        catch (Exception ex)
        {
            errorMessage = "Ошибка при очистке БД: " + ex.Message;
        }
    }

    private async Task LoadFromDb()
    {
        try
        {
            displayVacancies = await VacancyService.GetVacanciesAsync(showOnlySaved);
            ApplySorting();
            hasLoaded = true;
        }
        catch(Exception ex)
        {
            errorMessage = "Ошибка чтения БД: " + ex.Message;
        }
    }

    private async Task RejectVacancy(BlazorApp1.Models.Vacancy vac)
    {
        await VacancyService.RejectVacancyAsync(vac);
        displayVacancies.Remove(vac); 
    }

    private async Task SetView(bool showSaved)
    {
        showOnlySaved = showSaved;
        await LoadFromDb();
    }

    private async Task ToggleSave(BlazorApp1.Models.Vacancy vac)
    {
        await VacancyService.ToggleSaveAsync(vac);
    }

    private async Task StartParsing()
    {
        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            await BrowserStorage.SetAsync("savedKeyword", searchKeyword);
            await BrowserStorage.SetAsync("savedApiKey", apiKey);
            await BrowserStorage.SetAsync("savedRole", targetRole);
            await BrowserStorage.SetAsync("savedExp", targetExp);
            string keyword = Uri.EscapeDataString(searchKeyword);
            string role = Uri.EscapeDataString(targetRole);
            string exp = Uri.EscapeDataString(targetExp);
            string key = Uri.EscapeDataString(apiKey);
            string requestUrl = $"http://127.0.0.1:8000/parse/djinni?keyword={keyword}&api_key={key}&target_role={role}&target_exp={exp}";
            
            var response = await Http.GetFromJsonAsync<PythonApiResponse>(requestUrl);
            
            if (response != null && response.status == "success" && response.data != null && response.data.Any())
            {
                await VacancyService.SaveNewVacanciesAsync(response.data);
                showOnlySaved = false;
                await LoadFromDb();
            }
            else
            {
                errorMessage = response?.message ?? "Парсер вернул 0 вакансий.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка соединения с сервером Python: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private int ParseExperienceToMonths(string exp)
    {
        if (string.IsNullOrWhiteSpace(exp) || exp.ToLower().Contains("not specified")) 
            return -1;

        var lowerExp = exp.ToLower();
        var match = System.Text.RegularExpressions.Regex.Match(lowerExp, @"\d+");
        if (!match.Success) return -1;

        int number = int.Parse(match.Value);

        if (lowerExp.Contains("мес")) return number;
        if (lowerExp.Contains("год") || lowerExp.Contains("лет") || lowerExp.Contains("года")) return number * 12;

        return number;
    }

    public class PythonApiResponse
    {
        public string status { get; set; } = "";
        public string message { get; set; } = "";
        public int count { get; set; }
        public List<BlazorApp1.Models.Vacancy> data { get; set; } = new();
    }
}