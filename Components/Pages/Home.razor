    // ============================================================
    // Progress bar + Main parsing
    // ============================================================
    private int elapsedSeconds = 0;
    private int progressPercent = 5;
    private string loadingStatusText = "Поиск вакансий...";
    private System.Threading.CancellationTokenSource? loadingCts;

    private bool isSearching = false;

    private async Task StartParsing()
    {
        if (isLoading || isSearching) return;
        isLoading = true; isSearching = true; errorMessage = ""; modelSwitchWarning = "";
        elapsedSeconds = 0; progressPercent = 5;
        loadingStatusText = $"Поиск на {string.Join(", ", selectedPlatforms.Select(p => p.ToUpper()))}...";

        loadingCts = new System.Threading.CancellationTokenSource(TimeSpan.FromMinutes(4));
        var ct = loadingCts.Token;

        using var timer = new System.Timers.Timer(1000);
        var sw = System.Diagnostics.Stopwatch.StartNew();
        timer.Elapsed += async (_, _) =>
        {
            var s = (int)sw.Elapsed.TotalSeconds;
            if (s != elapsedSeconds) { elapsedSeconds = s; await InvokeAsync(StateHasChanged); }
        };
        timer.Start();
        StateHasChanged();

        try
        {
            await BrowserStorage.SetAsync("savedLanguage", targetLanguage);
            await BrowserStorage.SetAsync("savedApiKey", apiKey);
            await BrowserStorage.SetAsync("savedRole", targetRole);
            await BrowserStorage.SetAsync("savedExp", targetExp);

            await foreach (var ev in ParsingBackendClient.ParseVacanciesStreamAsync(
                selectedPlatforms, apiKey, SearchKeyword, targetRole, targetExp, targetLanguage,
                salaryExpectations, workFormat, englishLevel, employmentType, ct))
            {
                if (ev.Type == "progress")
                {
                    if (ev.Percent >= 0) progressPercent = ev.Percent;
                    loadingStatusText = ev.Message;
                    await InvokeAsync(StateHasChanged);
                }
                else if (ev.Type == "model_switch")
                {
                    modelSwitchWarning = ev.Message;
                    await InvokeAsync(StateHasChanged);
                }
                else if (ev.Type == "complete")
                {
                    progressPercent = 100; loadingStatusText = "Анализ завершён";
                    showCompletionAnim = true;
                    await InvokeAsync(StateHasChanged);
                    try { await Task.Delay(2500, ct); } catch (OperationCanceledException) { }
                    showCompletionAnim = false;

                    if (ev.Status == "success" && ev.Data != null && ev.Data.Any())
                    {
                        await VacancyService.SaveNewVacanciesAsync(ev.Data, ct);
                        showOnlySaved = false;
                        currentSortColumn = "AiMatchScore"; isAscending = false;
                        await LoadFromDb();
                    }
                    else { errorMessage = ev.Message ?? "Парсер вернул 0 вакансий."; }
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Поиск отменён или превышено время ожидания сервера (таймаут 4 мин).";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка соединения с сервером Python: {ex.Message}";
        }
        finally
        {
            timer.Stop();
            loadingCts?.Cancel(); loadingCts?.Dispose(); loadingCts = null;
            isLoading = false; isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ============================================================
    // Helper
    // ============================================================
    private int ParseExp(string exp)
    {
        if (string.IsNullOrWhiteSpace(exp) || exp.ToLower().Contains("not specified")) return -1;
        var m = System.Text.RegularExpressions.Regex.Match(exp.ToLower(), @"\d+");
        if (!m.Success) return -1;
        int n = int.Parse(m.Value);
        var lw = exp.ToLower();
        if (lw.Contains("мес")) return n;
        if (lw.Contains("год") || lw.Contains("лет") || lw.Contains("года")) return n * 12;
        return n;
    }
