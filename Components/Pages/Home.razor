    // ============================================================
    // Format helpers (Strict display)
    // ============================================================
    private string FormatExperience(string? exp)
    {
        if (string.IsNullOrWhiteSpace(exp))
            return "Опыт: в описании";

        var trimmed = exp.Trim();
        if (trimmed.StartsWith("Опыт:", StringComparison.OrdinalIgnoreCase))
            trimmed = trimmed.Substring(5).Trim();

        var tLow = trimmed.ToLowerInvariant();

        if (tLow.Contains("без") || tLow.Contains("no experience") || tLow.Contains("trainee") || tLow.Contains("студент"))
            return "Опыт: без опыта";

        if (tLow.Contains("в описі") || tLow.Contains("в описании") || tLow == "не указано" || tLow == "не указан")
            return "Опыт: в описании";

        // 0.5 year / 6 months / 0.5 року
        if (System.Text.RegularExpressions.Regex.IsMatch(tLow, @"(0[.,]5|пів|пол|6\s*міс|6\s*мес)"))
            return "Опыт: до 1 года";

        // Range: "1-3 года", "1-3 роки", "2-5 years", "1–3y"
        var rangeMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"(\d+)\s*[-–]\s*(\d+)");
        if (rangeMatch.Success)
            return $"Опыт: {rangeMatch.Groups[1].Value}-{rangeMatch.Groups[2].Value} года";

        // "5+ years", "5+ лет", "3+ роки"
        var plusMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"(\d+)\s*\+");
        if (plusMatch.Success)
        {
            int n = int.Parse(plusMatch.Groups[1].Value);
            string unit = n == 1 ? "год" : (n >= 2 && n <= 4) ? "года" : "лет";
            return $"Опыт: {n}+ {unit}";
        }

        // "от X лет", "від X років", "from X years"
        var fromMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"(?:від|от|from|більше|более)\s*(\d+)");
        if (fromMatch.Success)
        {
            int n = int.Parse(fromMatch.Groups[1].Value);
            string unit = n == 1 ? "года" : "лет";
            return $"Опыт: от {n} {unit}";
        }

        // Single digit e.g. "1 year", "2 роки", "5 years", "5 лет"
        var numMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"\b(\d+)\b");
        if (numMatch.Success)
        {
            int n = int.Parse(numMatch.Groups[1].Value);
            string unit = (n % 10 == 1 && n % 100 != 11) ? "год" :
                          (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20)) ? "года" : "лет";
            return $"Опыт: {n} {unit}";
        }

        return "Опыт: в описании";
    }

    private string FormatTechStack(BlazorApp1.Models.Vacancy vac)
    {
        var stack = vac.TechStack?.Trim();
        if (string.IsNullOrWhiteSpace(stack) || stack.Equals("Не указано", StringComparison.OrdinalIgnoreCase) || stack.Equals("Ошибка анализа", StringComparison.OrdinalIgnoreCase))
        {
            stack = ExtractStackFromTitle(vac.Title);
        }

        if (stack.StartsWith("Стек:", StringComparison.OrdinalIgnoreCase))
            return stack;

        return $"Стек: {stack}";
    }

    private string ExtractStackFromTitle(string title)
    {
        var known = new[] { "C#", ".NET", "ASP.NET", "WPF", "SQL", "Python", "JavaScript", "TypeScript", "React", "Vue", "Angular", "Node.js", "Java", "Go", "Rust", "C++", "Docker", "Kubernetes", "AWS", "Azure", "Flutter", "iOS", "Android", "QA", "Creatio", "Umbraco" };
        var found = new List<string>();
        var tLow = title.ToLowerInvariant();
        foreach (var k in known)
        {
            if (tLow.Contains(k.ToLowerInvariant()))
                found.Add(k);
        }
        if (found.Any())
            return string.Join(", ", found.Take(4));

        if (selectedStacks.Any())
            return string.Join(", ", selectedStacks.Take(3));

        return "C#, .NET";
    }

    private static MarkupString RenderMarkdown(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return (MarkupString)"";

        var encoded = System.Net.WebUtility.HtmlEncode(raw);

        // Headings
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"^###\s*(.+)$", "<h4 class=\"chat-h4\">$1</h4>", System.Text.RegularExpressions.RegexOptions.Multiline);
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"^##\s*(.+)$", "<h3 class=\"chat-h3\">$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);

        // Bold & Italic
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"(?<!\*)\*([^*]+?)\*(?!\*)", "<em>$1</em>");

        // Horizontal rule
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"^---+$", "<hr class=\"chat-hr\" />", System.Text.RegularExpressions.RegexOptions.Multiline);

        // Lists
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"^(\d+)\.\s+(.+)$", "<div class=\"chat-list-item\"><span class=\"chat-list-num\">$1.</span> $2</div>", System.Text.RegularExpressions.RegexOptions.Multiline);
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"^(?:-|\*|—)\s+(.+)$", "<div class=\"chat-list-item\"><span class=\"chat-list-bullet\">•</span> $1</div>", System.Text.RegularExpressions.RegexOptions.Multiline);

        // Line breaks
        encoded = encoded.Replace("\n", "<br />");
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"(<(?:h3|h4|div|hr)[^>]*>)<br\s*/?>", "$1");
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"</(?:h3|h4|div)><br\s*/?>", "</$1>");

        return (MarkupString)encoded;
    }

    // ============================================================
    // Pagination
    // ============================================================
    private void GoToPage(int p) { currentPage = p; expandedSummaries.Clear(); }
    private void PrevPage() { if (currentPage > 1) GoToPage(currentPage - 1); }
    private void NextPage() { if (currentPage < totalPages) GoToPage(currentPage + 1); }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (currentPage > 3) pages.Add(-1); // ellipsis
            for (int i = Math.Max(2, currentPage - 1); i <= Math.Min(totalPages - 1, currentPage + 1); i++)
                pages.Add(i);
            if (currentPage < totalPages - 2) pages.Add(-1);
            pages.Add(totalPages);
        }
        return pages;
    }

    // ============================================================
    // Sorting
    // ============================================================
    private string currentSortColumn = "AiMatchScore";
    private bool isAscending = false;

    private void SortBy(string col)
    {
        if (currentSortColumn == col) isAscending = !isAscending;
        else { currentSortColumn = col; isAscending = col != "AiMatchScore"; }
        ApplySorting();
    }

    private void ApplySorting()
    {
        displayVacancies = currentSortColumn switch
        {
            "Title"             => isAscending ? displayVacancies.OrderBy(v => v.Title).ToList() : displayVacancies.OrderByDescending(v => v.Title).ToList(),
            "RequiredExperience"=> isAscending ? displayVacancies.OrderBy(v => ParseExp(v.RequiredExperience)).ToList() : displayVacancies.OrderByDescending(v => ParseExp(v.RequiredExperience)).ToList(),
            "AiMatchScore"      => isAscending ? displayVacancies.OrderBy(v => v.AiMatchScore).ToList() : displayVacancies.OrderByDescending(v => v.AiMatchScore).ToList(),
            _                   => displayVacancies
        };
        currentTinderIndex = 0;
        currentPage = 1;
    }

