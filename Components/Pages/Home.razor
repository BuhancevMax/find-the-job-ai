    private MarkupString RenderMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text)) return (MarkupString)"";
        var encoded = System.Net.WebUtility.HtmlEncode(text)
            .Replace("\n", "<br/>");
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = System.Text.RegularExpressions.Regex.Replace(
            encoded, @"\`(.+?)\`", "<code>$1</code>");
        return (MarkupString)encoded;
    }

    // ============================================================
    // Format helpers (Strict display)
    // ============================================================
    private string FormatExperience(string? exp)
    {
        bool isUk = Loc.CurrentLanguage == "uk";
        string prefix = isUk ? "Досвід: " : "Experience: ";
        string inDesc = isUk ? "в описі" : "in description";
        string noExp = isUk ? "без досвіду" : "no experience";
        string under1 = isUk ? "до 1 року" : "under 1 year";

        if (string.IsNullOrWhiteSpace(exp))
            return prefix + inDesc;

        var trimmed = exp.Trim();
        if (trimmed.StartsWith("Опыт:", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("Досвід:", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("Experience:", StringComparison.OrdinalIgnoreCase))
        {
            var idx = trimmed.IndexOf(':');
            if (idx >= 0 && idx < trimmed.Length - 1)
                trimmed = trimmed.Substring(idx + 1).Trim();
        }

        var tLow = trimmed.ToLowerInvariant();

        if (tLow.Contains("без") || tLow.Contains("no experience") || tLow.Contains("trainee") || tLow.Contains("студент"))
            return prefix + noExp;

        if (tLow.Contains("в описі") || tLow.Contains("в описании") || tLow == "не указано" || tLow == "не указан" || tLow.Contains("in description"))
            return prefix + inDesc;

        // 0.5 year / 6 months / 0.5 року
        if (System.Text.RegularExpressions.Regex.IsMatch(tLow, @"(0[.,]5|пів|пол|6\s*міс|6\s*мес|6\s*month)"))
            return prefix + under1;

        // Range: "1-3 года", "1-3 роки", "2-5 years", "1–3y"
        var rangeMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"(\d+)\s*[-–]\s*(\d+)");
        if (rangeMatch.Success)
        {
            string unit = isUk ? "роки" : "years";
            return $"{prefix}{rangeMatch.Groups[1].Value}-{rangeMatch.Groups[2].Value} {unit}";
        }

        // "5+ years", "5+ лет", "3+ роки"
        var plusMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"(\d+)\s*\+");
        if (plusMatch.Success)
        {
            int n = int.Parse(plusMatch.Groups[1].Value);
            string unit;
            if (isUk)
                unit = n == 1 ? "рік" : (n >= 2 && n <= 4) ? "роки" : "років";
            else
                unit = n == 1 ? "year" : "years";
            return $"{prefix}{n}+ {unit}";
        }

        // "от X лет", "від X років", "from X years"
        var fromMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"(?:від|от|from|більше|более|more than)\s*(\d+)");
        if (fromMatch.Success)
        {
            int n = int.Parse(fromMatch.Groups[1].Value);
            string unit;
            if (isUk)
                unit = n == 1 ? "року" : (n >= 2 && n <= 4) ? "років" : "років";
            else
                unit = n == 1 ? "year" : "years";
            string fromWord = isUk ? "від" : "from";
            return $"{prefix}{fromWord} {n} {unit}";
        }

        // Single digit e.g. "1 year", "2 роки", "5 years", "5 лет"
        var numMatch = System.Text.RegularExpressions.Regex.Match(tLow, @"\b(\d+)\b");
        if (numMatch.Success)
        {
            int n = int.Parse(numMatch.Groups[1].Value);
            string unit;
            if (isUk)
                unit = (n % 10 == 1 && n % 100 != 11) ? "рік" :
                       (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20)) ? "роки" : "років";
            else
                unit = n == 1 ? "year" : "years";
            return $"{prefix}{n} {unit}";
        }

        return prefix + inDesc;
    }

    private string FormatTechStack(BlazorApp1.Models.Vacancy vac)
    {
        var stack = vac.TechStack?.Trim();
        if (string.IsNullOrWhiteSpace(stack) || stack.Equals("Не указано", StringComparison.OrdinalIgnoreCase) || stack.Equals("Ошибка анализа", StringComparison.OrdinalIgnoreCase))
        {
            stack = ExtractStackFromTitle(vac.Title);
        }

        string prefix = Loc.CurrentLanguage == "uk" ? "Стек: " : "Stack: ";
        if (stack.StartsWith("Стек:", StringComparison.OrdinalIgnoreCase) || stack.StartsWith("Stack:", StringComparison.OrdinalIgnoreCase))
        {
            var idx = stack.IndexOf(':');
            if (idx >= 0 && idx < stack.Length - 1)
                stack = stack.Substring(idx + 1).Trim();
        }

        return $"{prefix}{stack}";
    }

    private string ExtractStackFromTitle(string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return "В описі";
        var lower = title.ToLower();
        var known = new[] { "c#", ".net", "dotnet", "python", "django", "fastapi", "javascript", "typescript", "react", "vue", "angular", "node.js", "java", "spring", "golang", "go", "rust", "c++", "cpp", "qa", "devops", "flutter", "ios", "android", "php", "sql" };
        var found = known.Where(k => lower.Contains(k)).Select(k => k.ToUpper()).Take(4).ToList();
        return found.Any() ? string.Join(", ", found) : "В описі";
    }

    // ============================================================
    // Pagination
    // ============================================================
    private void GoToPage(int p) { currentPage = p; }
    private void PrevPage() { if (currentPage > 1) GoToPage(currentPage - 1); }
    private void NextPage() { if (currentPage < totalPages) GoToPage(currentPage + 1); }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (currentPage > 3) pages.Add(-1); // ellipsis
            int start = Math.Max(2, currentPage - 1);
            int end = Math.Min(totalPages - 1, currentPage + 1);
            for (int i = start; i <= end; i++) pages.Add(i);
            if (currentPage < totalPages - 2) pages.Add(-1); // ellipsis
            pages.Add(totalPages);
        }
        return pages;
    }

    // ============================================================
    // Sorting
    // ============================================================
    private void SortBy(string col)
    {
        if (currentSortColumn == col) isAscending = !isAscending;
        else { currentSortColumn = col; isAscending = col != "AiMatchScore"; }
        ApplySorting();
    }

    private void ApplySorting()
    {
        displayVacancies = currentSortColumn switch
        {
            "Title"             => isAscending ? displayVacancies.OrderBy(v => v.Title).ToList() : displayVacancies.OrderByDescending(v => v.Title).ToList(),
            "RequiredExperience"=> isAscending ? displayVacancies.OrderBy(v => ParseExp(v.RequiredExperience)).ToList() : displayVacancies.OrderByDescending(v => ParseExp(v.RequiredExperience)).ToList(),
            "AiMatchScore"      => isAscending ? displayVacancies.OrderBy(v => v.AiMatchScore).ToList() : displayVacancies.OrderByDescending(v => v.AiMatchScore).ToList(),
            _                   => displayVacancies
        };
        currentTinderIndex = 0;
        currentPage = 1;
    }

